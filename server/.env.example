# Cổng khởi chạy server backend
PORT=5000

# Chuỗi kết nối MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/techshare?retryWrites=true&w=majority

# Khóa bí mật ký JWT Token
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Google Gemini AI API Key (Lấy miễn phí tại: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Môi trường chạy (development / production)
NODE_ENV=development
